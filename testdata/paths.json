    {
      "name": "macos defaults",
      "env": {
        "os": "macos",
        "home": "/Users/ann",
        "todo_tui_home": null,
        "xdg_config_home": null,
        "xdg_data_home": null,
        "xdg_state_home": null,
        "xdg_runtime_dir": null,
        "tmpdir": "/var/folders/xy/abc123/T/",
        "uid": 501
      },
      "expect": {
        "config": "/Users/ann/.config/todo-tui/config.toml",
        "data": "/Users/ann/Library/Application Support/todo-tui",
        "logs": "/Users/ann/Library/Logs/todo-tui",
        "runtime": "/var/folders/xy/abc123/T/todo-tui",
        "socket": "/var/folders/xy/abc123/T/todo-tui/daemon.sock",
        "lock": "/Users/ann/Library/Application Support/todo-tui/daemon.lock"
      }
    },
